PORT=8787
BIND_HOST=127.0.0.1
AUTH_TOKEN=change_me

SOLANA_RPC_HTTP=https://your-private-rpc.example.com
SOLANA_RPC_WS=wss://your-private-rpc.example.com

# Runtime toggles
JITO_ENABLED=true
PUMPFUN_ENABLED=true
RAYDIUM_ENABLED=true

# Program IDs (mainnet)
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
RAYDIUM_AMM_V4_PROGRAM_ID=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8

# Tx enrichment (RPC-heavy)
ENRICHER_ENABLED=true
ENRICHER_MAX_QPS=8
ENRICHER_MAX_QUEUE=500

# Assessment and risk
ASSESSMENT_ENABLED=true
ASSESSMENT_TICK_MS=1500
ASSESSMENT_ALERT_RISK=70

# Auth hardening
AUTH_MAX_FAILURES_PER_MIN=40
AUTH_MAX_CONSECUTIVE_FAILURES=8
AUTH_BLOCK_SECONDS=300

# 24/7 security sentinel
SECURITY_ENABLED=true
SECURITY_TICK_MS=3000
SECURITY_STALE_HEARTBEAT_MS=15000
SECURITY_MAX_MEMORY_MB=1200
SECURITY_MAX_UNAUTHORIZED_PER_MIN=60
SECURITY_AUTO_PAUSE_ON_CRITICAL=true
